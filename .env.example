# ============================================================================
# Predict-Polymarket 套利机器人 环境配置
# 复制为 .env 并填写真实值: cp .env.example .env
# ============================================================================

# Predict API (必填)
PREDICT_API_KEY=
# Predict 签名钱包私钥 (Privy 嵌入式钱包)
PREDICT_SIGNER_PRIVATE_KEY=
# Predict 充值地址 (智能合约钱包)
PREDICT_SMART_WALLET_ADDRESS=

# Polymarket — 只需填私钥
# 下方代理地址与 L2 凭证留空时，dashboard 启动阶段自动从私钥派生并写回本文件
# (需 Python + pip install -r tools/requirements.txt)
POLYMARKET_TRADER_PRIVATE_KEY=
POLYMARKET_PROXY_ADDRESS=
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_PASSPHRASE=

# Telegram 通知 (可选)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# BSC WSS 低延迟节点 (可选; 未填或连接失败时自动回退到公共节点)
# BSC_WS_QUICKNODE=

# 对冲参数 (可选)
# 对冲滑点容忍 (tick 数, 1 tick = 0.01, 默认 3)
# HEDGE_SLIPPAGE_TICKS=3
# POLY_MAKER_PREDICT_HEDGE_SLIPPAGE_TICKS=3
# 最小对冲名义金额与 dust 阈值
# MIN_HEDGE_NOTIONAL=1.5
# POLY_MIN_ORDER_NOTIONAL=1.10
# Pending 事件作为 Predict 成交后的快速对冲触发源 (默认 true)
# PENDING_HEDGE_TRIGGER_ENABLED=true
