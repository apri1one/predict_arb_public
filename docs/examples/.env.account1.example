# ============================================================================
# 账号 1 配置示例
# 复制为 .env.account1 并填写真实值
# 启动: npm run dashboard -- --env .env.account1 --port 3020 --account account1
# ============================================================================

# Predict API
PREDICT_API_KEY=

# Predict 签名钱包私钥 (Privy 嵌入式钱包, 签名地址自动派生)
PREDICT_SIGNER_PRIVATE_KEY=
# Predict 充值地址 (智能合约钱包)
PREDICT_SMART_WALLET_ADDRESS=

# Polymarket — 只需填私钥
# 下方代理地址与 L2 凭证留空时，dashboard 启动阶段自动从私钥派生并写回本文件
POLYMARKET_TRADER_PRIVATE_KEY=
POLYMARKET_PROXY_ADDRESS=
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_PASSPHRASE=

# Telegram (可选，可与其他账号共用)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
